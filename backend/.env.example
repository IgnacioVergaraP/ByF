# Flask
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
SECRET_KEY=dev-secret-change-me

# CORS (Angular local)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Base de datos local (SQLite)
# La ruta relativa de SQLite se resuelve desde backend/instance/.
DATABASE_URL=sqlite:///conciliacion.db

# Supabase. Activa USE_DATA_API para probar esta conexión desde Flask local.
USE_DATA_API=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Acceso privado de la aplicación en Vercel
# APP_USERNAME=
# APP_PASSWORD=
