{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "bash backend/build_vercel.sh",
  "functions": {
    "wsgi.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/web/**,backend/tessdata/**}",
      "excludeFiles": "{backend/instance/**,backend/migrations/**,backend/tests/**,frontend/**,data/**,.conda/**}"
    }
  }
}
